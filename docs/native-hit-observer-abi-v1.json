{
  "abi_version": 1,
  "record_bytes": 96,
  "endianness": "little",
  "proposed_observer_enums_not_game_enums": true,
  "installed": false,
  "game_connection_verified": false,
  "branch": {"unknown": 0, "normal_final": 1, "physical_success": 2},
  "capture_flags": {
    "direct_verified": 1,
    "full_peer_verified": 2,
    "selected_ap_verified": 4,
    "armour_verified": 8,
    "default_custom_known": 16,
    "final_force_known": 32,
    "target_hostile_verified": 64,
    "ap_delta_verified": 128,
    "supported_mode_verified": 256
  },
  "effect_flags": {"hitinfo_force": 1, "projectile_force": 2, "custom_curve": 4},
  "target_kind": {"unknown": 0, "proven_hostile": 1},
  "fields": {
    "sequence": {"offset": 0, "type": "u64", "source": "observer accepted-record transport sequence"},
    "epoch": {"offset": 8, "type": "u64", "source": "observer identity epoch"},
    "creditor": {"offset": 16, "type": "u64", "lua_representation": "two u32 halves, never a double"},
    "projectile_context": {"offset": 24, "type": "u64"},
    "projectile_slot": {"offset": 32, "type": "u32"},
    "projectile_generation": {"offset": 36, "type": "u32", "zero_when_unproven": true},
    "contact_ordinal": {"offset": 40, "type": "u32", "source": "observer per-contact identity, not target dedup"},
    "target": {"offset": 44, "type": "u32"},
    "source": {"offset": 48, "type": "u32"},
    "owner": {"offset": 52, "type": "u32"},
    "effect_flags": {"offset": 56, "type": "u32"},
    "native_branch": {"offset": 60, "type": "u32", "value_domain": "proposed observer branch"},
    "selected_ap": {"offset": 64, "type": "f32"},
    "armour": {"offset": 68, "type": "f32"},
    "factor": {"offset": 72, "type": "f32", "not_a_four_class_result": true},
    "damage": {"offset": 76, "type": "f32"},
    "attack_kind": {"offset": 80, "type": "u32", "value_domain": "raw HitInfo source kind, not proposed attack enum"},
    "target_kind": {"offset": 84, "type": "u32", "value_domain": "proposed observer target"},
    "capture_flags": {"offset": 88, "type": "u32"},
    "ap_delta": {"offset": 92, "type": "f32", "source": "native SUBSS rounding; missing validity bit means unknown"}
  },
  "count_contract": {
    "ap_stage_publishes_or_counts": false,
    "normal_final_submits_joined_contact_once": true,
    "physical_success_requires_actual_success_branch": true,
    "transport_sequence_not_contact_branch_dedup": true,
    "unknown_fields_have_missing_capture_bits": true,
    "normal_classes_require_default_custom_known_and_final_force_known": true,
    "normal_classes_use_native_ap_delta_not_double_recomputed_subtraction": true,
    "all_classes_require_direct_full_peer_proven_hostile_and_supported_mode": true,
    "creditor_must_match_current_local_peer_exactly": true,
    "drop_or_overflow_marks_partial_and_is_not_estimated": true,
    "no_total_game_projectiles_hit_equality_claim": true
  }
}
